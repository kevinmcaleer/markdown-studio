# Copy to .env and fill in. docker compose reads this file automatically.

# Optional. A long random string used to sign CSRF tokens. Leave it empty and
# one is generated on first run and kept in ./data/.secret_key.
# To set your own:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Port the app listens on (inside and outside the container).
PORT=8000

# Address to publish the port on. Use 127.0.0.1 if a reverse proxy on the
# same host terminates HTTPS, so the app isn't reachable directly.
BIND_ADDRESS=0.0.0.0

# Where the SQLite database lives. In Docker this is inside the ./data mount.
DATABASE_PATH=/data/studio.db

# Allow new people to sign up. The very first account can always be created
# on a fresh install, so you can set this to false from the start.
ALLOW_REGISTRATION=false

# DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stdout.
LOG_LEVEL=INFO

# Set to true when users reach the app over HTTPS (adds the Secure cookie flag).
HTTPS=false

# Set to true when running behind a reverse proxy (Caddy, Traefik, nginx) so
# X-Forwarded-For / X-Forwarded-Proto are honoured.
TRUST_PROXY=false

# Share the login cookie with sibling subdomains, e.g. .kevspowertools.com.
# Leave empty on a home network.
COOKIE_DOMAIN=

# The address people use to reach the app, e.g. https://studio.kevspowertools.com
# or http://studio.local:8000. Password reset emails link back here.
PUBLIC_URL=

# --- Email (optional) ---------------------------------------------------------
# Lets people reset a forgotten password from a link sent by email. Leave
# SMTP_HOST empty to turn it off; `python -m studio reset-password` always works.
# Any SMTP server will do: your mail provider (Fastmail, iCloud, Gmail with an
# app password), a sending service (Brevo, Mailgun, SES, SendGrid) or a relay on
# your network. PUBLIC_URL above must be set too.
SMTP_HOST=
# 587 with starttls (the usual), 465 with ssl, or 25 with none for a trusted
# local relay. SMTP_PORT defaults to match SMTP_SECURITY.
SMTP_SECURITY=starttls
# SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Who the emails come from, e.g. Markdown Studio <studio@example.com>
SMTP_FROM=
# PASSWORD_RESET_MAX_AGE=3600    # seconds a reset link stays valid

# Largest file a user can upload, in megabytes. Files are stored inside studio.db.
# MAX_UPLOAD_MB=25

# Google Docs sync (optional). Create a "Web application" OAuth client in the
# Google Cloud console with the Drive API enabled and this redirect URI:
#   <PUBLIC_URL>/api/cloud/google/callback
# See "Google Docs sync" in README.md. Leave empty to hide Google Docs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_SYNC_INTERVAL=300       # seconds between background syncs; 0 = only on request

# Notes' language tools (optional). Spelling and Look Up work without these.
# LanguageTool gives full grammar checking; LibreTranslate turns on Translate.
# Uncomment COMPOSE_PROFILES to run both from docker-compose.yml (with the
# tunnel too: COMPOSE_PROFILES=tunnel,language), or point
# these at servers elsewhere on your network. See "Language tools" in README.md.
# COMPOSE_PROFILES=language
# LANGUAGETOOL_URL=http://languagetool:8010
# LIBRETRANSLATE_URL=http://libretranslate:5000
# LIBRETRANSLATE_API_KEY=
# LT_LOAD_ONLY=en,fr,es,de       # languages LibreTranslate loads (fewer = less memory)

# Host user/group ids that should own the files in ./data (run `id` on the host).
PUID=1000
PGID=1000

# Which published image to run: latest (moves on every release), edge (every
# merge to main) or a pinned version such as v1.2. scripts/auto-update.sh follows it.
# STUDIO_TAG=latest

# Optional tuning
# SESSION_MAX_AGE=86400          # seconds a login lasts without "remember me"
# REMEMBER_ME_MAX_AGE=2592000    # seconds a "remember me" login lasts
# LOGIN_RATE_LIMIT=5             # login/register attempts allowed...
# LOGIN_RATE_WINDOW=60           # ...per this many seconds, per IP
# POWERTOOLS_APPS_URL=https://kevspowertools.com/apps.json  # app switcher list; empty = built-in copy
# POWERTOOLS_HIDE=noodleplanner,filmcolab  # app ids to leave out of the switcher

# --- Cloudflare Tunnel (optional) -------------------------------------------
# Publishes the app at your own hostname through Cloudflare, with no open ports.
# 1. Uncomment both lines below and paste the token of a remotely-managed tunnel
#    (Cloudflare dashboard > Zero Trust > Networks > Tunnels > your tunnel >
#    the long string after `--token` in the install command).
# 2. Also set HTTPS=true and TRUST_PROXY=true above.
# 3. The COMPOSE_FILE line stops the app publishing PORT on the host, since
#    cloudflared reaches it over the compose network. Leave it out if you also
#    want to reach the app directly on http://<host>:PORT.
# See "Cloudflare Tunnel" in README.md, including the note on multiple nodes.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
