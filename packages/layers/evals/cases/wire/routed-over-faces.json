{
  "title": "Wire routed down the front of a servo and along a plate",
  "why": "Each waypoint was clicked on a face: the wire must pass through each one with its middle a radius off the face (lying on it, not in it). Measured in the world: the servo is 40 mm right of the plate's middle.",
  "input": {
    "parts": [
      { "id": "plate", "position": [0, 0, 0] },
      { "id": "servo", "position": [40, 0, 20], "parent": "plate" }
    ],
    "wire": {
      "from": { "part": "servo", "point": [0, 0, 20], "normal": [0, 0, 1] },
      "to": { "part": "plate", "point": [-40, 0, 2], "normal": [0, 0, 1] },
      "waypoints": [
        { "part": "servo", "point": [0, -12, 0], "normal": [0, -1, 0] },
        { "part": "plate", "point": [0, -20, 2], "normal": [0, 0, 1] }
      ],
      "color": "#2f6fd6",
      "diameter": 2,
      "slack": 0
    }
  },
  "expect": {
    "leaves": true,
    "through": [
      { "at": [40, -12, 20], "normal": [0, -1, 0] },
      { "at": [0, -20, 2], "normal": [0, 0, 1] }
    ]
  }
}
