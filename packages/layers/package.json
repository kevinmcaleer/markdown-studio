{
  "name": "@markdown-studio/layers",
  "private": true,
  "version": "0.1.0",
  "description": "Layers: a Canva-style canvas for text, shapes and pictures. A graphic is saved as a PNG that carries its own layers.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/layers.js",
  "module": "./dist/layers.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/layers.js"
    },
    "./doc": {
      "source": "./src/docOnly.ts",
      "types": "./dist/types/docOnly.d.ts",
      "default": "./dist/doc.js"
    }
  },
  "scripts": {
    "dev": "vite demo",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fabric": "6.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
